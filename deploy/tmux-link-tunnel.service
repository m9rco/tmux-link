[Unit]
Description=Tmux Link outbound SSH tunnel
After=network-online.target
Wants=network-online.target
[Service]
User=alice
ExecStart=/usr/local/bin/tmux-link-agent tunnel tmux-center /home/tmuxrelay/link/primary.sock 2201
Restart=always
RestartSec=5
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
